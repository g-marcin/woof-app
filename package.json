{
    "name": "woof-app",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "start": "vite",
        "dev": "vite --host 0.0.0.0",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "biome lint src",
        "lint:fix": "biome lint src --fix",
        "format": "biome format . --write",
        "check": "biome check . --fix",
        "api:generate": "openapi-ts",
        "install-git-hook": "node scripts/install-git-hook.js",
        "api-types:link": "npx --yes yalc add @mgrzmil-org/api-types && bun install",
        "api-types:unlink": "npx --yes yalc remove @mgrzmil-org/api-types --pure && bun install"
    },
    "dependencies": {
        "@mgrzmil-org/api-types": "^0.0.2",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
        "@opentelemetry/instrumentation-xml-http-request": "^0.221.0",
        "@opentelemetry/sdk-trace-web": "^2.10.0",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/react-query": "^5.90.19",
        "axios": "^1.4.0",
        "dotenv": "^17.2.3",
        "firebase": "^12.7.0",
        "i18next": "^25.7.3",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "react-error-boundary": "^6.1.2",
        "react-i18next": "^16.5.0",
        "react-router-dom": "^7.11.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.11",
        "@hey-api/openapi-ts": "^0.99.0",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.2",
        "typescript": "^5.0.2",
        "vite": "^7.3.0"
    }
}
